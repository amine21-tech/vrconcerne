# Copiez ce fichier en .env et renseignez de vraies valeurs.
# Jamais de vrai secret dans ce fichier : il est commite tel quel.

NODE_ENV=development
PORT=3101
HOST=0.0.0.0

DATABASE_URL=postgres://vrc:vrc@127.0.0.1:5433/vrc

# Generer un vrai secret :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PUBLIC_BASE_URL=http://localhost:3101

# Origines autorisees pour le front (separees par des virgules). '*' en dev uniquement.
# L'app Android empaquetee par Capacitor (androidScheme: 'https') sert son
# contenu depuis l'origine https://localhost — a inclure explicitement en
# production, en plus du domaine web s'il y en a un.
CORS_ORIGINS=*

# Chargily Pay (tableau de bord sandbox : https://pay.chargily.dz)
CHARGILY_API_KEY=test_sk_...
CHARGILY_API_SECRET=test_...
CHARGILY_WEBHOOK_SECRET=whsec_...
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2

# Page/deep-link vers laquelle Chargily redirige apres paiement.
APP_RETURN_URL=http://localhost:3000/payment/return

LOG_LEVEL=info
